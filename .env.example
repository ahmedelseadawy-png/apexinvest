# ApexInvest — server environment variables.
# Copy to .env for local testing ONLY if you export them yourself; on Render/Railway/Fly you type them
# into the dashboard. NEVER commit a real .env (it is git-ignored). Every variable below is actually read by the code.

# ---- hosting ---------------------------------------------------------------------------------
PORT=8000                       # set by the host automatically; the start command uses it
APEX_ENV=production             # "production" = CORS lock-down, rate limits, no /docs, security headers. Unset/other = original local behaviour.
APEX_WORKERS=1                  # uvicorn worker processes (start command). 1 fits a 512 MB instance.
LOG_LEVEL=INFO

# ---- access control (recommended for anything on the internet) ---------------------------------
# "name:key" pairs, comma-separated. Every /v1/* call (except /v1/health) then needs the key.
# Use a long random key (>= 20 characters). To revoke a person, delete their pair and redeploy.
APEX_ACCESS_KEYS=me:REPLACE-WITH-A-LONG-RANDOM-KEY

# ---- market data (required in production) ------------------------------------------------------
# EODHD is the ONLY production market-data provider -- Yahoo has been removed from the
# production fetch path entirely. Get a token at eodhd.com and set the REAL value only via
# your deployment platform's environment variables (e.g. FastAPI Cloud) -- never commit it here.
EODHD_API_TOKEN=...
EODHD_EGX_SUFFIX=EGX            # exchange suffix used by EODHD for Egypt; only change if EODHD says otherwise
DATA_PROVIDER=eodhd             # EODHD is the only supported value; unset/blank also resolves to EODHD.

# ---- TradingView Screenshot Analysis (optional; feature stays disabled if unset) ----------------
# Optional visual-confirmation layer (POST /v1/analyses/screenshot) -- independent of the
# EODHD/CSV analysis above; leaving these unset simply disables the endpoint, nothing else changes.
# Anthropic is the default/recommended provider, via the official `anthropic` SDK.
VISION_PROVIDER=anthropic
VISION_API_KEY=                 # set the REAL key only via your deployment platform (e.g. FastAPI Cloud) -- never commit it here.
VISION_MODEL=claude-opus-5      # current Anthropic vision-capable model; override to claude-sonnet-5 or claude-haiku-4-5 for lower cost.

# ---- browser access (optional) ------------------------------------------------------------------
# The server hosts both UIs itself, so on the default domain you leave these EMPTY.
ALLOWED_ORIGINS=                # e.g. https://apexinvest.example.com  (comma-separated; only for a different-host front end)
PUBLIC_API_BASE=                # e.g. https://api.example.com  (absolute https origin the /m/ app should call; empty = same server)

# ---- abuse limits (optional; defaults shown) ----------------------------------------------------
# APEX_RL_HEAVY=6               # scan / backtest / portfolio, requests per minute per caller
# APEX_RL_ANALYSIS=40           # single-stock analysis, CSV upload, fundamentals
# APEX_RL_GENERAL=120           # everything else
# APEX_RL_AUTH=10               # failed access-key attempts per minute before a cool-down
# APEX_HEAVY_CONCURRENCY=2      # scans/backtests running at the same time
# APEX_MAX_UPLOAD_MB=15         # CSV / Excel upload size
# APEX_MAX_BODY_MB=5            # any other request body
# APEX_TRUST_PROXY_HOPS=1       # proxies in front of the app (Render/Railway/Fly = 1)
